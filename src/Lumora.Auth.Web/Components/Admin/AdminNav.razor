@* Page header of an admin page (the menu itself lives in AdminLayout). *@
<div class="lm-page-head">
    <h1>@Title</h1>
    @Actions
    @if (Subtitle is not null)
    {
        <p>@Subtitle</p>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "Админка";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
