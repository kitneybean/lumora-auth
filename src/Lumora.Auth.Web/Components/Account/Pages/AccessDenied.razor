@page "/Account/AccessDenied"
@using Lumora.Auth.Data
@using Lumora.Auth.Web.Security

<PageTitle>Нет доступа — Lumora</PageTitle>

@if (HttpContext.User.IsInRole(Roles.Admin) && !Policies.HasMfa(HttpContext.User))
{
    <AdminNeeds2fa />
}
else
{
    <AuthHeader Icon="lock" Tone="danger" Title="Нет доступа" Subtitle="Эта страница доступна только администраторам." />
    <a href="" class="btn btn-outline-secondary w-100">На главную</a>
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;
}
