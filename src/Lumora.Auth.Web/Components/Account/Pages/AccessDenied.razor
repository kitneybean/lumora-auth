@page "/Account/AccessDenied"
@using Lumora.Auth.Data
@using Lumora.Auth.Web.Security

<PageTitle>Нет доступа — Lumora</PageTitle>

@if (HttpContext.User.IsInRole(Roles.Admin) && !Policies.HasMfa(HttpContext.User))
{
    <Lumora.Auth.Web.Components.Shared.AdminNeeds2fa />
}
else
{
    <h1>Нет доступа</h1>
    <p>Эта страница доступна только администраторам.</p>
    <p><a href="">На главную</a></p>
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;
}
