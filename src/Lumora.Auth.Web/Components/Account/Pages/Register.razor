@page "/Account/Register"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Lumora.Auth.Data
@using Lumora.Auth.Web.Profiles

@inject UserManager<ApplicationUser> UserManager
@inject IUserStore<ApplicationUser> UserStore
@inject SignInManager<ApplicationUser> SignInManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject ProfileService Profiles
@inject Lumora.Auth.Web.Settings.SiteSettingsService Site
@inject ILogger<Register> Logger
@inject Lumora.Auth.Web.Security.RegistrationGuard RegistrationGuard
@inject Lumora.Auth.Web.Security.AuditService Audit
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Регистрация — Lumora</PageTitle>

<AuthHeader Icon="register" Title="Регистрация" Subtitle="Аккаунт для сайта и лаунчера. Ник — имя персонажа в игре." />

@if (!Site.Current.RegistrationOpen)
{
    <div class="alert alert-warning mb-0">Регистрация сейчас закрыта. Если аккаунт уже есть — <a href="Account/Login" class="alert-link">войдите</a>.</div>
    return;
}

<StatusMessage Message="@Message" />
<EditForm Model="Input" method="post" OnValidSubmit="RegisterUser" FormName="register">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" role="alert" />
    <div class="mb-3">
        <label for="Input.PlayerName" class="form-label">Ник в игре</label>
        <InputText @bind-Value="Input.PlayerName" id="Input.PlayerName" class="form-control" autocomplete="nickname" aria-required="true" placeholder="Steve" />
        <div class="form-text">@ProfileService.NameRules</div>
        <ValidationMessage For="() => Input.PlayerName" class="text-danger" />
    </div>
    <div class="mb-3">
        <label for="Input.Email" class="form-label">E-mail</label>
        <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
        <ValidationMessage For="() => Input.Email" class="text-danger" />
    </div>
    <div class="row g-3 mb-4">
        <div class="col-sm-6">
            <label for="Input.Password" class="form-label">Пароль</label>
            <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" />
            <ValidationMessage For="() => Input.Password" class="text-danger" />
        </div>
        <div class="col-sm-6">
            <label for="Input.ConfirmPassword" class="form-label">Ещё раз</label>
            <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" />
            <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
        </div>
    </div>
    @* Honeypot: hidden from people, bots fill every field. *@
    <div class="lm-hp" aria-hidden="true">
        <label for="Input.Website">Сайт</label>
        <InputText @bind-Value="Input.Website" id="Input.Website" tabindex="-1" autocomplete="off" />
    </div>
    <button type="submit" class="w-100 btn btn-lg btn-primary">Создать аккаунт</button>
</EditForm>
<hr />
<p class="text-center mb-0">Уже есть аккаунт? <a href="Account/Login">Войти</a></p>

@code {
    private string? errorMessage;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? Message => errorMessage is null ? null : $"Error: {errorMessage}";

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    public async Task RegisterUser(EditContext editContext)
    {
        if (!Site.Current.RegistrationOpen)
            return;
        if (!string.IsNullOrEmpty(Input.Website))
        {
            Audit.Log(HttpContext, "account.register", false, "бот: заполнено скрытое поле", userName: Input.Email);
            errorMessage = "Не удалось зарегистрироваться.";
            return;
        }
        if (!RegistrationGuard.TryRegister(Lumora.Auth.Web.Security.ClientIp.Of(HttpContext)))
        {
            Audit.Log(HttpContext, "account.register", false, "лимит регистраций с IP", userName: Input.Email);
            errorMessage = "С этого адреса уже регистрировались несколько раз. Попробуйте через час.";
            return;
        }
        var playerName = Input.PlayerName.Trim();
        if (await Profiles.ValidateNameAsync(playerName) is { } nameError)
        {
            errorMessage = nameError;
            return;
        }

        var user = new ApplicationUser();
        await UserStore.SetUserNameAsync(user, Input.Email, CancellationToken.None);
        await ((IUserEmailStore<ApplicationUser>)UserStore).SetEmailAsync(user, Input.Email, CancellationToken.None);
        var result = await UserManager.CreateAsync(user, Input.Password);
        if (!result.Succeeded)
        {
            errorMessage = string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        if (await Profiles.CreateAsync(user.Id, playerName) is { } profileError)
        {
            await UserManager.DeleteAsync(user);
            errorMessage = profileError;
            return;
        }

        Logger.LogInformation("Registered {Email} as {Player}", Input.Email, playerName);
        Audit.Log(HttpContext, "account.register", true, $"ник {playerName}", userName: Input.Email);

        var userId = await UserManager.GetUserIdAsync(user);
        var code = await UserManager.GenerateEmailConfirmationTokenAsync(user);
        code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
        var callbackUrl = NavigationManager.GetUriWithQueryParameters(
            NavigationManager.ToAbsoluteUri("Account/ConfirmEmail").AbsoluteUri,
            new Dictionary<string, object?> { ["userId"] = userId, ["code"] = code, ["returnUrl"] = ReturnUrl });

        await EmailSender.SendConfirmationLinkAsync(user, Input.Email, HtmlEncoder.Default.Encode(callbackUrl));

        if (UserManager.Options.SignIn.RequireConfirmedAccount)
        {
            RedirectManager.RedirectTo(
                "Account/RegisterConfirmation",
                new() { ["email"] = Input.Email, ["returnUrl"] = ReturnUrl });
        }
        else
        {
            await SignInManager.SignInAsync(user, isPersistent: false);
            RedirectManager.RedirectTo(ReturnUrl);
        }
    }

    private sealed class InputModel
    {
        /// <summary>Honeypot field; must stay empty.</summary>
        public string? Website { get; set; }

        [Required(ErrorMessage = "Укажите ник.")]
        [RegularExpression("^[A-Za-z0-9_]{3,16}$", ErrorMessage = "Ник: " + ProfileService.NameRules)]
        public string PlayerName { get; set; } = "";

        [Required(ErrorMessage = "Укажите e-mail.")]
        [EmailAddress(ErrorMessage = "Некорректный e-mail.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Придумайте пароль.")]
        [StringLength(100, ErrorMessage = "Пароль должен быть от {2} до {1} символов.", MinimumLength = 8)]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare("Password", ErrorMessage = "Пароли не совпадают.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
