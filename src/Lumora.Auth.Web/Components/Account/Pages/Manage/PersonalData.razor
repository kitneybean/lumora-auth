@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using Lumora.Auth.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Личные данные — Lumora</PageTitle>

<div class="lm-page-head">
    <h1>Личные данные</h1>
    <p>Всё, что сайт хранит о вас: e-mail, ник, скин и настройки безопасности.</p>
</div>
<StatusMessage />
<div class="row g-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5"><Icon Name="download" /> Скачать</h2>
                <p class="text-body-secondary">Файл JSON со всеми данными аккаунта.</p>
                <form action="Account/Manage/DownloadPersonalData" method="post">
                    <AntiforgeryToken />
                    <button class="btn btn-outline-secondary" type="submit">Скачать данные</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100 lm-danger-card">
            <div class="card-body">
                <h2 class="h5"><Icon Name="delete" /> Удалить аккаунт</h2>
                <p class="text-body-secondary">Аккаунт, ник и скин удаляются навсегда.</p>
                <a href="Account/Manage/DeletePersonalData" class="btn btn-outline-danger">Удалить…</a>
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
