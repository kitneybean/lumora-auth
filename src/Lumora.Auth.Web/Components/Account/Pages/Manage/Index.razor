@page "/Account/Manage"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Lumora.Auth.Core.Entities
@using Lumora.Auth.Core.Profiles
@using Lumora.Auth.Data
@using Lumora.Auth.Web.Profiles

@inject UserManager<ApplicationUser> UserManager
@inject ProfileService Profiles
@inject IdentityRedirectManager RedirectManager

<PageTitle>Игровой профиль — Lumora</PageTitle>

<h3>Игровой профиль</h3>
<StatusMessage />

<div class="row">
    <div class="col-xl-7">
        @if (profile is not null)
        {
            <dl class="row mb-4">
                <dt class="col-sm-4">Ник</dt>
                <dd class="col-sm-8"><b>@profile.Name</b></dd>
                <dt class="col-sm-4">UUID</dt>
                <dd class="col-sm-8"><code>@MinecraftUuid.ToUnsigned(profile.Id)</code></dd>
                <dt class="col-sm-4">Вход в лаунчер</dt>
                <dd class="col-sm-8">по нику или e-mail <b>@email</b></dd>
            </dl>
        }
        else
        {
            <div class="alert alert-warning">
                У аккаунта ещё нет игрового профиля — без него нельзя зайти на сервер. Придумайте ник.
            </div>
        }

        <EditForm Model="Input" FormName="profile" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.PlayerName" id="Input.PlayerName" class="form-control" placeholder="Steve" />
                <label for="Input.PlayerName">@(profile is null ? "Ник" : "Новый ник")</label>
                <div class="form-text">@ProfileService.NameRules UUID при смене ника не меняется.</div>
                <ValidationMessage For="() => Input.PlayerName" class="text-danger" />
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">@(profile is null ? "Создать профиль" : "Сменить ник")</button>
        </EditForm>
    </div>
</div>

@code {
    private ApplicationUser? user;
    private PlayerProfile? profile;
    private string? email;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        email = user.Email;
        profile = await Profiles.FindByUserAsync(user.Id);
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var name = Input.PlayerName.Trim();
        var error = profile is null
            ? await Profiles.CreateAsync(user.Id, name)
            : await Profiles.RenameAsync(user.Id, name);

        RedirectManager.RedirectToCurrentPageWithStatus(
            error is null ? (profile is null ? "Профиль создан." : "Ник изменён.") : "Error: " + error,
            HttpContext);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Укажите ник.")]
        [RegularExpression("^[A-Za-z0-9_]{3,16}$", ErrorMessage = "Ник: " + ProfileService.NameRules)]
        public string PlayerName { get; set; } = "";
    }
}
