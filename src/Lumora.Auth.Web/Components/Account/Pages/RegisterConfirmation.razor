@page "/Account/RegisterConfirmation"

@using Microsoft.AspNetCore.Identity
@using Lumora.Auth.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Подтвердите e-mail — Lumora</PageTitle>

<AuthHeader Icon="email" Title="Почти готово" />
<StatusMessage Message="@statusMessage" />

@if (statusMessage is null)
{
    <p>Мы отправили письмо на <b>@Email</b>. Откройте ссылку из письма, чтобы подтвердить почту, — после этого можно входить на сайт и в лаунчер.</p>
    <p class="text-body-secondary mb-0">Письма нет? Проверьте «Спам» или <a href="Account/ResendEmailConfirmation">отправьте ещё раз</a>.</p>
}

@code {
    private string? statusMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Email is null)
        {
            RedirectManager.RedirectTo("");
            return;
        }

        if (await UserManager.FindByEmailAsync(Email) is null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            statusMessage = "Error: Аккаунт с таким e-mail не найден.";
        }
    }
}
