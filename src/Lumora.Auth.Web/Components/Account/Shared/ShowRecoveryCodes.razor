<div class="lm-page-head">
    <h1>Коды восстановления</h1>
    <p>Если телефон потеряется, войти можно будет одним из этих кодов. Каждый код работает один раз.</p>
</div>
<StatusMessage Message="@StatusMessage" />
<div class="alert alert-warning lm-narrow" role="alert">
    Сохраните коды сейчас — например, в менеджере паролей или на бумаге. Больше сайт их не покажет.
</div>
<div class="card lm-narrow">
    <div class="card-body">
        <div class="lm-recovery">
            @foreach (var recoveryCode in RecoveryCodes)
            {
                <code class="recovery-code">@recoveryCode</code>
            }
        </div>
        <div class="d-flex flex-wrap gap-2 mt-3">
            <button type="button" class="btn btn-outline-secondary" data-copy="@string.Join("\n", RecoveryCodes)"><Icon Name="copy" Size="18" /> Скопировать</button>
            <a href="Account/Manage/TwoFactorAuthentication" class="btn btn-primary">Готово</a>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
