# Domain of the site (A record must point at this server). The site will be https://<domain>.
LUMORA_DOMAIN=auth.example.com

# Long random password; never change it after the first start (the database keeps the old one).
POSTGRES_PASSWORD=change-me

# First administrator, created on the first start. Remove the password from this file afterwards.
LUMORA_ADMIN_EMAIL=admin@example.com
LUMORA_ADMIN_PASSWORD=change-me-too
